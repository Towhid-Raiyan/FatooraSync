generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  SALES_RECEIPT
  QUOTATION
}

enum Unit {
  PIECE
  KG
  BOX
  CARTON
  LITER
}

model Tenant {
  id            String   @id @default(uuid())
  legalName     String
  tradeNameEn   String
  tradeNameAr   String?
  vatNumber     String
  crNumber      String?
  address       String?
  defaultLocale String   @default("ar")
  createdAt     DateTime @default(now())

  users     User[]
  settings  Settings?
  customers Customer[]
  products  Product[]
  documents Document[]
}

model Settings {
  id             String  @id @default(uuid())
  tenantId       String  @unique
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  defaultVatRate Decimal @default(15.00) @db.Decimal(5, 2)
  language       String  @default("ar")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions Session[]
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  vatId     String?
  address   String?
  phone     String?
  crNumber  String?
  isWalkIn  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  documents Document[]

  @@unique([tenantId, vatId])
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nameEn    String
  nameAr    String?
  sku       String?
  barcode   String?
  unit      Unit     @default(PIECE)
  unitPrice Decimal  @db.Decimal(12, 2)
  vatRate   Decimal? @db.Decimal(5, 2)
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  lines DocumentLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

model Document {
  id                     String       @id @default(uuid())
  tenantId               String
  tenant                 Tenant       @relation(fields: [tenantId], references: [id])
  type                   DocumentType
  number                 Int
  customerId             String
  customer               Customer     @relation(fields: [customerId], references: [id])
  subtotal               Decimal      @db.Decimal(12, 2)
  vatTotal               Decimal      @db.Decimal(12, 2)
  grandTotal             Decimal      @db.Decimal(12, 2)
  notes                  String?
  creditNoteOfDocumentId String?
  creditNoteOf           Document?    @relation("CreditNote", fields: [creditNoteOfDocumentId], references: [id])
  creditNotes            Document[]   @relation("CreditNote")
  uuid                   String       @default(uuid())
  invoiceHash            String?
  previousInvoiceHash    String?
  qrCode                 String?
  createdAt              DateTime     @default(now())

  lines DocumentLine[]

  @@unique([tenantId, type, number])
}

model DocumentLine {
  id           String   @id @default(uuid())
  tenantId     String
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  quantity     Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @db.Decimal(12, 2)
  vatRate      Decimal  @db.Decimal(5, 2)
  lineSubtotal Decimal  @db.Decimal(12, 2)
  lineVat      Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
}
