generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentType {
  SALES_RECEIPT
  QUOTATION
}

enum Unit {
  PIECE
  KG
  BOX
  CARTON
  LITER
  DOZEN
}

enum PrintFormat {
  THERMAL
  A4
}

enum BillingStatus {
  TRIALING
  ACTIVE
  COMPLIMENTARY
  PAST_DUE
  SUSPENDED
}

enum UserRole {
  OWNER
  CASHIER
}

enum AgencyStaffRole {
  CTO
  DEVELOPER
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
}

enum StockAdjustmentReason {
  DAMAGE
  LOSS_THEFT
  RECOUNT
  OTHER
}

enum PaymentMethod {
  CASH
  CREDIT
}

model Tenant {
  id                        String        @id @default(uuid())
  legalName                 String
  tradeNameEn               String
  tradeNameAr               String?
  vatNumber                 String
  crNumber                  String?
  address                   String?
  phone                     String?
  defaultLocale             String        @default("ar")
  createdAt                 DateTime      @default(now())
  nextProductSkuNumber      Int           @default(1)
  nextSalesReceiptNumber    Int           @default(1)
  nextQuotationNumber       Int           @default(1)
  nextPurchaseReceiptNumber Int           @default(1)
  lastSalesReceiptHash      String?
  billingStatus             BillingStatus @default(TRIALING)
  trialEndsAt               DateTime?
  featureFlags              Json          @default("{}")

  users                User[]
  settings             Settings?
  customers            Customer[]
  products             Product[]
  documents            Document[]
  documentLines        DocumentLine[]
  suppliers            Supplier[]
  stockMovements       StockMovement[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseReceiptLines PurchaseReceiptLine[]
}

model Settings {
  id                      String      @id @default(uuid())
  tenantId                String      @unique
  tenant                  Tenant      @relation(fields: [tenantId], references: [id])
  defaultVatRate          Decimal     @default(15.00) @db.Decimal(5, 2)
  language                String      @default("en")
  printFormat             PrintFormat @default(THERMAL)
  cashierCanManageCatalog Boolean     @default(true)
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions       Session[]
  stockMovements StockMovement[]
}

// Reserved, not currently used: Task 4's auth is JWT-based (Auth.js rejects
// database sessions for a Credentials-only provider), so nothing writes to
// this table today. Kept in the schema for a future manual database-session
// layer, e.g. revocable staff logins - Cashier accounts exist now, and their
// sessions aren't actually revocable on deactivation (see auth.config.ts),
// an accepted gap rather than still-hypothetical future work.
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
}

model AgencyStaff {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         AgencyStaffRole @default(DEVELOPER)
  createdAt    DateTime        @default(now())

  auditLogs AuditLog[]
}

model AuditLog {
  id            String      @id @default(uuid())
  agencyStaffId String
  agencyStaff   AgencyStaff @relation(fields: [agencyStaffId], references: [id])
  action        String
  tenantId      String?
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now())
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  vatId     String?
  address   String?
  phone     String?
  crNumber  String?
  isWalkIn  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  documents Document[]

  @@unique([tenantId, vatId])
}

model Product {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  nameEn            String
  nameAr            String?
  sku               String?
  barcode           String?
  unit              Unit     @default(PIECE)
  unitPrice         Decimal  @db.Decimal(12, 2)
  vatRate           Decimal? @db.Decimal(5, 2)
  quantity          Decimal  @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal? @db.Decimal(12, 3)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  lines                DocumentLine[]
  stockMovements       StockMovement[]
  purchaseReceiptLines PurchaseReceiptLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

model Document {
  id                     String       @id @default(uuid())
  tenantId               String
  tenant                 Tenant       @relation(fields: [tenantId], references: [id])
  type                   DocumentType
  number                 Int
  customerId             String
  customer               Customer     @relation(fields: [customerId], references: [id])
  subtotal               Decimal      @db.Decimal(12, 2)
  vatTotal               Decimal      @db.Decimal(12, 2)
  grandTotal             Decimal      @db.Decimal(12, 2)
  notes                  String?
  creditNoteOfDocumentId String?
  creditNoteOf           Document?    @relation("CreditNote", fields: [creditNoteOfDocumentId], references: [id])
  creditNotes            Document[]   @relation("CreditNote")
  uuid                   String       @default(uuid())
  invoiceHash            String?
  previousInvoiceHash    String?
  qrCode                 String?
  createdAt              DateTime     @default(now())

  lines          DocumentLine[]
  stockMovements StockMovement[]

  @@unique([tenantId, type, number])
}

model DocumentLine {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  quantity     Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @db.Decimal(12, 3)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  vatRate      Decimal  @db.Decimal(5, 2)
  lineSubtotal Decimal  @db.Decimal(12, 2)
  lineVat      Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)

  @@index([documentId])
  @@index([tenantId])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  vatId     String?
  crNumber  String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockMovements   StockMovement[]
  purchaseReceipts PurchaseReceipt[]

  @@index([tenantId])
}

// The purchase-side twin of Document/DocumentLine: one purchase receipt per
// delivery, however many products it contains, saved as a single record --
// mirrors how a Sales Receipt bundles multiple lines under one document
// rather than requiring one save per product. Never submitted to ZATCA (that
// only applies to outgoing sales invoices) -- this is purely the business's
// own purchasing/input-VAT record.
model PurchaseReceipt {
  id                    String        @id @default(uuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  number                Int
  supplierReceiptNumber String?
  supplierId            String
  supplier              Supplier      @relation(fields: [supplierId], references: [id])
  purchaseDate          DateTime
  paymentMethod         PaymentMethod
  subtotal              Decimal       @db.Decimal(12, 2)
  vatTotal              Decimal       @db.Decimal(12, 2)
  grandTotal            Decimal       @db.Decimal(12, 2)
  createdAt             DateTime      @default(now())

  lines          PurchaseReceiptLine[]
  stockMovements StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, purchaseDate])
}

model PurchaseReceiptLine {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  purchaseReceiptId String
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  productName       String
  unit              Unit
  quantity          Decimal         @db.Decimal(12, 3)
  unitPrice         Decimal         @db.Decimal(12, 3)
  vatRate           Decimal         @db.Decimal(5, 2)
  lineSubtotal      Decimal         @db.Decimal(12, 2)
  lineVat           Decimal         @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(12, 2)

  @@index([purchaseReceiptId])
  @@index([tenantId])
}

// Append-only ledger: every change to a product's stock (sale, restock, or
// adjustment) gets its own permanent, attributed row. Product.quantity stays
// the fast "current stock" read path -- this table is written alongside it,
// never replayed to derive it. See applyStockMovement() in
// src/lib/inventory/apply-stock-movement.ts, the only code path allowed to
// write to either.
model StockMovement {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  productId         String
  product           Product                @relation(fields: [productId], references: [id])
  type              StockMovementType
  quantityDelta     Decimal                @db.Decimal(12, 3)
  quantityAfter     Decimal                @db.Decimal(12, 3)
  reason            StockAdjustmentReason?
  note              String?
  unitCost          Decimal?               @db.Decimal(12, 2)
  supplierId        String?
  supplier          Supplier?              @relation(fields: [supplierId], references: [id])
  documentId        String?
  document          Document?              @relation(fields: [documentId], references: [id])
  purchaseReceiptId String?
  purchaseReceipt   PurchaseReceipt?       @relation(fields: [purchaseReceiptId], references: [id])
  createdByUserId   String
  createdByUser     User                   @relation(fields: [createdByUserId], references: [id])
  createdAt         DateTime               @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}
