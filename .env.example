# DATABASE_URL: a restricted, non-owner Postgres role used for the app's runtime queries.
# On Neon: Project dashboard -> Roles -> Add role, then use its connection string here.
# Tenant isolation does NOT depend on this role's privileges (Neon roles cannot have
# BYPASSRLS removed, so Postgres RLS can't enforce anything here - see docs/specs and
# Task 3 of the foundation plan). This split is still worth keeping as ordinary
# least-privilege practice: the app's own credentials shouldn't be able to manage
# roles, drop tables, etc.
DATABASE_URL="postgresql://app_user:password@host/dbname?sslmode=require"

# DIRECT_URL: the database owner role, used only for running migrations (prisma migrate).
DIRECT_URL="postgresql://owner_user:password@host/dbname?sslmode=require"

# AUTH_SECRET: signs and encrypts Auth.js session JWTs. Required at runtime
# (Auth.js throws MissingSecret on any request without it) - generate a fresh
# value per environment, e.g. `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-random-32-byte-base64-value"

# SENTRY_DSN: the ingest URL for this app's Sentry project. Used by
# sentry.server.config.ts / sentry.edge.config.ts (Node.js/edge runtimes,
# which read real process env at request time) to report unhandled errors.
# Leave unset locally to disable error reporting.
SENTRY_DSN=

# NEXT_PUBLIC_SENTRY_DSN: same value as SENTRY_DSN above, duplicated under
# the NEXT_PUBLIC_ prefix. sentry.client.config.ts runs in the browser, and
# Next.js only inlines NEXT_PUBLIC_*-prefixed env vars into the client
# bundle at build time -- the unprefixed SENTRY_DSN would resolve to
# undefined there, silently disabling client-side error reporting.
NEXT_PUBLIC_SENTRY_DSN=
